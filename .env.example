# 复制为 .env，首次启动前填写；后续启动不会覆盖已有账号。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
APP_ORIGIN=http://localhost:3000
DATABASE_PATH=./data/trust-admin.sqlite
PORT=3000

# 本地开发连接宿主机的原三个服务。Docker 内请改为服务名或 host.docker.internal。
FAKE_NEWS_UPSTREAM_URL=http://localhost:30101
BOT_DETECTION_UPSTREAM_URL=http://localhost:30102
AIGT_UPSTREAM_URL=http://localhost:30103

# Compose 连接三个后端已经所在的 Docker 网络。
BACKEND_NETWORK=trust-backend
